# ==============================================================
# Rust Hour — API Health Monitor Configuration
# ==============================================================
# Each service reads env vars prefixed with its name.
# e.g., auth-service reads AUTH_DATABASE_URL, AUTH_PASETO_KEY, AUTH_PORT
# ==============================================================

RUST_LOG=info

# ==============================================================
# Auth Service (prefix: AUTH_)
# ==============================================================
AUTH_DATABASE_URL=postgres://postgres:password@localhost:5432/auth_db
AUTH_PASETO_KEY=your-secure-32-byte-key-here!!!!
AUTH_PORT=50051

# ==============================================================
# Monitor Service (prefix: MONITOR_)
# ==============================================================
MONITOR_DATABASE_URL=postgres://postgres:password@localhost:5432/monitor_db
MONITOR_KAFKA_BROKERS=localhost:19092
MONITOR_PORT=50052

# ==============================================================
# Alert Service (prefix: ALERT_)
# ==============================================================
ALERT_DATABASE_URL=postgres://postgres:password@localhost:5432/alert_db
ALERT_KAFKA_BROKERS=localhost:19092
ALERT_PORT=50053

# ==============================================================
# Monitor Query Service (prefix: MONITOR_QUERY_)
# ==============================================================
MONITOR_QUERY_DATABASE_URL=postgres://postgres:password@localhost:5432/monitor_db
MONITOR_QUERY_KAFKA_BROKERS=localhost:19092
MONITOR_QUERY_REDIS_URL=redis://localhost:6379

# ==============================================================
# Saga Orchestrator (prefix: SAGA_)
# ==============================================================
SAGA_DATABASE_URL=postgres://postgres:password@localhost:5432/saga_db
SAGA_AUTH_SERVICE_URL=http://[::1]:50051
SAGA_MONITOR_SERVICE_URL=http://[::1]:50052
SAGA_ALERT_SERVICE_URL=http://[::1]:50053

# ==============================================================
# Gateway (prefix: GATEWAY_)
# ==============================================================
GATEWAY_AUTH_SERVICE_URL=http://[::1]:50051
GATEWAY_MONITOR_SERVICE_URL=http://[::1]:50052
GATEWAY_ALERT_SERVICE_URL=http://[::1]:50053
GATEWAY_REDIS_URL=redis://localhost:6379
GATEWAY_PORT=8080
GATEWAY_GRPC_TIMEOUT_MS=5000
GATEWAY_RATE_LIMIT_PER_MIN=100
